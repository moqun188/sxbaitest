/* pages/words/words.wxss */

.search-bar {
  margin-bottom: 20rpx;
}
.search-input {
  background: #1e293b;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  color: #f1f5f9;
  font-size: 28rpx;
  border: 1rpx solid rgba(255,255,255,0.1);
}

.filter-scroll {
  white-space: nowrap;
  margin-bottom: 20rpx;
}
.filter-item {
  display: inline-block;
  padding: 12rpx 28rpx;
  background: #1e293b;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #94a3b8;
  margin-right: 16rpx;
  border: 1rpx solid rgba(255,255,255,0.05);
}
.filter-item.active {
  background: #38bdf8;
  color: #0f172a;
  font-weight: 600;
}

.add-input {
  background: #0f172a;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  color: #f1f5f9;
  font-size: 28rpx;
  border: 1rpx solid rgba(255,255,255,0.1);
}
