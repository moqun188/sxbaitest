<!-- pages/settings/settings.wxml -->
<view class="container">
  <view class="page-title">⚙️ 设置</view>
  <view class="page-subtitle">系统配置</view>

  <!-- 听写设置 -->
  <view class="card">
    <view class="card-title">🎤 听写设置</view>

    <view class="setting-item">
      <text class="setting-label">朗读间隔</text>
      <picker mode="selector" range="{{intervals}}" range-key="label" value="{{intervalIndex}}" bindchange="onIntervalChange">
        <view class="setting-value">{{intervals[intervalIndex].label}} ▼</view>
      </picker>
    </view>

    <view class="setting-item">
      <text class="setting-label">朗读重复</text>
      <picker mode="selector" range="{{repeats}}" value="{{repeatIndex}}" bindchange="onRepeatChange">
        <view class="setting-value">{{repeats[repeatIndex]}} 次 ▼</view>
      </picker>
    </view>

    <view class="setting-item">
      <text class="setting-label">每次听写词数</text>
      <picker mode="selector" range="{{counts}}" value="{{countIndex}}" bindchange="onCountChange">
        <view class="setting-value">{{counts[countIndex]}} 个 ▼</view>
      </picker>
    </view>
  </view>

  <!-- 数据管理 -->
  <view class="card">
    <view class="card-title">💾 数据管理</view>

    <view class="setting-item" bindtap="exportData">
      <text class="setting-label">导出数据</text>
      <text class="setting-value" style="color:#38bdf8">导出 →</text>
    </view>

    <view class="setting-item" bindtap="resetData">
      <text class="setting-label">重置为演示数据</text>
      <text class="setting-value" style="color:#fbbf24">重置</text>
    </view>

    <view class="setting-item" bindtap="clearAll">
      <text class="setting-label">清空所有数据</text>
      <text class="setting-value" style="color:#fb7185">清空</text>
    </view>
  </view>

  <!-- 关于 -->
  <view class="card">
    <view class="card-title">ℹ️ 关于</view>
    <view class="setting-item">
      <text class="setting-label">版本</text>
      <text class="setting-value" style="color:#94a3b8">v2.0.0</text>
    </view>
    <view class="setting-item">
      <text class="setting-label">项目</text>
      <text class="setting-value" style="color:#94a3b8">sxbaitest</text>
    </view>
    <view class="setting-item">
      <text class="setting-label">开发者</text>
      <text class="setting-value" style="color:#94a3b8">陈总(B) / 向博(A)</text>
    </view>
  </view>
</view>
